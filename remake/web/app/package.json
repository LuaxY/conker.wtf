{
  "name": "conker-landing",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "serve": "bun server.ts",
    "build": "rm -rf ../landing && vite build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "oxlint --react-plugin --jsx-a11y-plugin --deny-warnings src server.ts",
    "format": "oxfmt",
    "check": "bun run typecheck && bun run lint && oxfmt --check"
  },
  "dependencies": {
    "@fontsource/black-ops-one": "^5.3.0",
    "@fontsource/luckiest-guy": "^5.3.0",
    "@tanstack/react-router": "^1.170.42",
    "lucide-react": "^1.55.0",
    "motion": "^14.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
